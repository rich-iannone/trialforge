{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rich-iannone/trialforge/spec/study-spec.schema.json",
  "title": "trialforge study spec",
  "description": "v0 study spec (JSON or YAML). The engine consumes `study` (archetype, seed, studyid, standards), `population.n`, `controls` and `outputs`. `data_quality.defects` injects seeded data-quality defects. The other sections are reserved for later phases and are rejected with a pointer to `controls` until their engine work lands.",
  "type": "object",
  "required": [
    "study"
  ],
  "additionalProperties": false,
  "properties": {
    "spec_version": {
      "const": 0
    },
    "study": {
      "type": "object",
      "required": [
        "archetype",
        "seed"
      ],
      "additionalProperties": false,
      "properties": {
        "studyid": {
          "type": "string",
          "pattern": "^[A-Z0-9_-]{1,20}$"
        },
        "archetype": {
          "description": "Study-type archetype supplying defaults. Omit for a fully explicit spec.",
          "type": "string",
          "enum": [
            "parallel_continuous",
            "oncology_solid_tumor",
            "oncology_single_arm_ph2",
            "dose_escalation",
            "heme_lymphoma",
            "phase1_sad_mad",
            "crossover_be",
            "dose_ranging_ph2",
            "cns_alzheimers",
            "cv_outcomes",
            "respiratory_exacerbation",
            "vaccine",
            "ophthalmology",
            "pediatric_growth"
          ]
        },
        "modifiers": {
          "type": "array",
          "items": {
            "enum": [
              "non_inferiority",
              "open_label_extension",
              "multiple_cuts",
              "adaptive",
              "crossover_on_progression",
              "multi_regional",
              "blinded"
            ]
          },
          "uniqueItems": true
        },
        "seed": {
          "description": "Root RNG seed. Limited to 2^53 so it round-trips through R doubles and JSON.",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740992
        },
        "standards": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sdtmig": {
              "enum": [
                "3.4"
              ]
            },
            "adamig": {
              "enum": [
                "1.3"
              ]
            },
            "define": {
              "enum": [
                "2.1"
              ]
            },
            "ct": {
              "type": "string",
              "format": "date"
            }
          }
        },
        "start_date": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "population": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 1,
          "default": 300
        }
      }
    },
    "design": {
      "type": "object",
      "properties": {
        "arms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "armcd",
              "arm"
            ],
            "properties": {
              "armcd": {
                "type": "string",
                "pattern": "^[A-Z0-9_]{1,20}$"
              },
              "arm": {
                "type": "string",
                "maxLength": 200
              },
              "ratio": {
                "type": "number",
                "exclusiveMinimum": 0,
                "default": 1
              }
            },
            "additionalProperties": true
          }
        },
        "randomization": {
          "type": "object"
        },
        "enrollment_months": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cutoff": {
          "type": "object"
        },
        "assessments": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "endpoints": {
      "type": "object"
    },
    "safety": {
      "type": "object"
    },
    "dropout": {
      "type": "object"
    },
    "data_quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defects": {
          "description": "Data-quality defects injected into the clean, verified study, with a manifest (defects.json). \"none\", a profile (\"light\": about five common defects; \"realistic\": rates per eligible record; \"adversarial\": three of every type in its subtlest form), or a map of defect id to a count or a rate.",
          "oneOf": [
            {
              "enum": [
                "none",
                "light",
                "realistic",
                "adversarial"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ae_end_before_start": {
                  "$ref": "#/$defs/defectAmount"
                },
                "duplicate_seq": {
                  "$ref": "#/$defs/defectAmount"
                },
                "out_of_ct": {
                  "$ref": "#/$defs/defectAmount"
                },
                "orphan_usubjid": {
                  "$ref": "#/$defs/defectAmount"
                },
                "record_after_death": {
                  "$ref": "#/$defs/defectAmount"
                },
                "bad_study_day": {
                  "$ref": "#/$defs/defectAmount"
                },
                "chg_mismatch": {
                  "$ref": "#/$defs/defectAmount"
                },
                "missing_baseline": {
                  "$ref": "#/$defs/defectAmount"
                },
                "trtemfl_wrong": {
                  "$ref": "#/$defs/defectAmount"
                },
                "cnsr_wrong": {
                  "$ref": "#/$defs/defectAmount"
                }
              }
            }
          ]
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "formats": {
          "type": "array",
          "items": {
            "enum": [
              "xpt",
              "csv",
              "dataset-json",
              "parquet"
            ]
          },
          "uniqueItems": true,
          "default": [
            "xpt"
          ]
        },
        "layout": {
          "enum": [
            "flat",
            "submission"
          ],
          "default": "flat",
          "description": "flat: one folder with every format; submission: sdtm/ and adam/ folders with XPT and define.xml"
        }
      }
    },
    "controls": {
      "description": "Archetype controls (see `controls(archetype)` in either binding). Merged over the archetype's defaults; unknown names are an error.",
      "type": "object"
    }
  },
  "$defs": {
    "defectAmount": {
      "description": "A number written without a decimal point is a count of records (all eligible ones if fewer); any other number is a per-record rate in [0, 1].",
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      ]
    }
  }
}
